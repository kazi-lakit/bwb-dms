# Blocks OIDC login config for the "bwb" project — deployed ("dev"
# environment) build of dms-app. Same project/tenant/OIDC client as local
# dev (see .env.local / .env.example), just a different app domain.
#
# Consumed by set-env.cjs (via `npm run build:dev`), which copies this file
# to .env before `vite build` runs. Values are not secret (a public PKCE
# client needs no client_secret); tracked in git so a fresh CI checkout can
# run the Docker build.
#
# TODO before first deploy:
#  1. Replace the placeholder VITE_BLOCKS_APP_DOMAIN with the real deployed
#     domain assigned by Blocks OS.
#  2. Register https://<deployed-domain>/login/callback as a redirect URI on
#     the OIDC client (same one local dev uses). If updating via
#     `blocks auth oidc-clients save`, resend EVERY field — it replaces, not
#     merges (see beef-app-react/CLAUDE.md's deployment notes).

VITE_BLOCKS_API_URL=https://blocksapi.dev.slsblx.com
VITE_BLOCKS_PROJECT_KEY=D2b2b7d30b27f41bdb97833319e639e3f
VITE_BLOCKS_APP_DOMAIN=https://TODO-DEPLOYED-DOMAIN.slsblx.com
VITE_BLOCKS_OIDC_CLIENT_ID=e880c5aa-81ea-4a24-a7eb-646ceae827e7
VITE_BLOCKS_OIDC_URL=https://iam.seliseblocks.com
VITE_BLOCKS_OIDC_SCOPE=openid profile

# Deployed build talks to the storage service through the main Blocks
# gateway (mode "live" ignores VITE_BLOCKS_STORAGE_API_URL and uses
# VITE_BLOCKS_API_URL — see src/lib/blocks/config.ts).
VITE_BLOCKS_STORAGE_MODE=live

# No VITE_BLOCKS_DEV_HOST/PORT here — those only affect vite.config.ts's
# local dev-server block, which doesn't run during `vite build`.
